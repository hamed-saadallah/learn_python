# Set to "true" to use mocked PDF extraction and Mistral LLM responses (default for local dev).
USE_MOCKS=true

# Required when USE_MOCKS=false
MISTRAL_API_KEY=your_mistral_api_key_here

# Default PDF path passed to the crew
PDF_PATH=data/documents/sample_report.pdf

# Mistral model routed through CrewAI / LiteLLM
MISTRAL_MODEL=mistral/mistral-small-latest

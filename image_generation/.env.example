# Set to "false" to call the real Mistral Agents image_generation API.
USE_MOCKS=true

# Required when USE_MOCKS=false — get a key at https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Chat model that drives the agent (image pixels come from the image_generation tool).
MISTRAL_MODEL=mistral-medium-latest
